PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Authentication Secrets (Generate strong random strings for production)
JWT_ACCESS_SECRET=your_super_strong_jwt_access_secret_here
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_secret_here
JWT_ACCESS_EXPIRY=15m

# Default Administrator Account (Used during initial seeding)
DEFAULT_OWNER_EMAIL=owner@yourdomain.com
DEFAULT_OWNER_PASSWORD=your_initial_secure_password
DEFAULT_OWNER_NAME=Transia Owner

# CORS & Frontend URLs (comma-separated for multiple domains)
FRONTEND_URL=http://localhost:5173,https://your-production-app.vercel.app
CATALOG_URL=https://catalogapp-six.vercel.app/

# WhatsApp Integration (options: none, ultramsg, twilio, meta)
WHATSAPP_PROVIDER=none
DEFAULT_COUNTRY_CODE=+91
OWNER_ALERT_PHONE=+919876543210

# UltraMsg Configuration (when WHATSAPP_PROVIDER=ultramsg)
ULTRAMSG_INSTANCE_ID=your_ultramsg_instance_id
ULTRAMSG_TOKEN=your_ultramsg_token

# Twilio Configuration (when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Meta WhatsApp Cloud API (when WHATSAPP_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
